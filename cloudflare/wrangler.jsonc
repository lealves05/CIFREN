// CIFREN — site + /api. Hospedagem oficial: VPS (lorler-edge lê este arquivo e troca API_UPSTREAM pela API local).
// Cloudflare só em emergência: npx wrangler deploy -c cloudflare/wrangler.jsonc
{
  "$schema": "../frontend/node_modules/wrangler/config-schema.json",
  "name": "cifren-web",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "PRODUCT_ID": "cifren",
    "API_UPSTREAM": "https://cifren.lorler.com.br",
    "SESSION_COOKIES": "__Host-cifren_s"
  },
  "observability": { "enabled": true }
}
